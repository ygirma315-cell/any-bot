# Telegram Bot Credentials (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Admin Chat ID (Your personal Telegram ID or Channel ID to receive order notifications)
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# Telegram API ID & Hash (For Telegram WebApp / Bot API integrations)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Public App URL (Localhost during development, Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
