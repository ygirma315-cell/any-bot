# Telegram Bot Token (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJklmnOPQRstUVwxYZ_example

# Telegram Admin Chat ID (Your personal Telegram ID or Channel ID to receive order notifications)
TELEGRAM_ADMIN_CHAT_ID=123456789

# Public WebApp / App URL (Localhost during development, Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Next.js Environment (development | production)
NODE_ENV=development
